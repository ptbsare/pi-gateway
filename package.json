{
  "name": "@ptbsare/pi-gateway",
  "version": "0.0.2",
  "publishConfig": {
    "access": "public"
  },
  "description": "微信 ClawBot ↔ pi 桥接服务（iLink 协议直连）| Bridge service connecting the pi coding agent to WeChat ClawBot via the iLink protocol",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "src/index.ts",
  "bin": {
    "pi-gateway": "bin/pi-gateway.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "README_en.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc",
    "serve": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --testTimeout=15000",
    "test:watch": "vitest"
  },
  "keywords": [
    "weixin",
    "wechat",
    "wechat-bot",
    "wechat-bridge",
    "clawbot",
    "ilink",
    "pi",
    "gateway",
    "agent",
    "ai-agent",
    "coding-agent",
    "chatbot",
    "bridge",
    "typescript",
    "nodejs"
  ],
  "license": "MIT",
  "author": "ptbsare",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ptbsare/pi-gateway.git"
  },
  "homepage": "https://github.com/ptbsare/pi-gateway#readme",
  "bugs": {
    "url": "https://github.com/ptbsare/pi-gateway/issues"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4",
    "qrcode-terminal": "0.12.0",
    "tsx": "^4.19.0",
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^5.8.0",
    "vitest": "^3.2.7"
  }
}
